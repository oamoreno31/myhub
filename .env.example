# ── Supabase ─────────────────────────────────────────────
# Local: `pnpm db:start` y copia los valores que imprime (API URL y Publishable key).
# Producción: Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Llave secreta (sb_secret_…). SOLO servidor, usada por las rutas /api/cron/*.
SUPABASE_SECRET_KEY=

# ── Acceso ───────────────────────────────────────────────
# Correos autorizados, separados por coma. Nadie más puede entrar.
ALLOWED_EMAILS=oamoreno31@gmail.com

# ── Tareas programadas (Vercel Cron) ─────────────────────
# Cadena aleatoria larga. Vercel la envía como "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# ── General ──────────────────────────────────────────────
APP_TIMEZONE=America/Bogota
