# ── Supabase ─────────────────────────────────────────────
# Local: `pnpm db:start` y copia los valores que imprime (API URL y Publishable key).
# Producción: Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Llave secreta (sb_secret_…). SOLO servidor, usada por las rutas /api/cron/*.
SUPABASE_SECRET_KEY=

# ── Acceso ───────────────────────────────────────────────
# Correos autorizados, separados por coma. Nadie más puede entrar.
ALLOWED_EMAILS=oamoreno31@gmail.com

# ── Tareas programadas (Vercel Cron) ─────────────────────
# Cadena aleatoria larga. Vercel la envía como "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# ── General ──────────────────────────────────────────────
APP_TIMEZONE=America/Bogota

# ── Correo de recordatorios (opcional, F6) ──────────────
# Llave de https://resend.com. Sin llave, el cron no envía correos (todo lo demás funciona).
RESEND_API_KEY=
# Remitente. Con dominio propio verificado en Resend, p. ej. "Plata Clara <avisos@devtopia.co>".
# Sin dominio verificado, Resend solo entrega a tu propio correo desde onboarding@resend.dev.
EMAIL_FROM=Plata Clara <onboarding@resend.dev>
# URL pública para los enlaces del correo (en Vercel se deduce sola).
APP_URL=
